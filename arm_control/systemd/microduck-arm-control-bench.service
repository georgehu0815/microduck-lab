[Unit]
Description=Microduck arm bench placeholder (hardware hard-denied)
Documentation=file:///opt/robot/arm-control/docs/CONTROL.md
After=local-fs.target

[Service]
Type=exec
User=microduck-arm
Group=microduck-arm
RuntimeDirectory=microduck-arm
RuntimeDirectoryMode=0750
UMask=0007
ExecStart=/usr/bin/python3 -m arm_control.daemon --transport dynamixel --devices left-arm,right-arm --socket /run/microduck-arm/control.sock
Restart=no
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX
DevicePolicy=closed

[Install]
# Intentionally no WantedBy. The daemon rejects this hardware transport.
